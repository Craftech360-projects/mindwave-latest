<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Game</title>
    <link rel="stylesheet" href="/asset/css/jqx.base.css" type="text/css" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1 maximum-scale=1 minimum-scale=1"
    />
    <script src="/socket.io/socket.io.js"></script>
    <script
      type="text/javascript"
      src="/asset/js/jquery-1.12.4.min.js"
    ></script>
    <style type="text/css">
      @font-face {
        font-family: "ArchivoBlack";
        src: url("../asset/Archivo_Black/ArchivoBlack-Regular.ttf")
          format("truetype");
      }

      html,
      body {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        background-image: url("../asset/images/bg2.png");
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        font-family: "ArchivoBlack";
      }

      #clock {
        position: absolute;
        color: white;
        left: 50%;
        top: 5%;
        width: 100px;
        height: 100px;
        border-radius: 10px;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 16px;
      }

      #clock::before {
        content: "";
        position: absolute;
        z-index: -2;
        left: -50%;
        top: -50%;
        width: 200%;
        height: 200%;
        background-color: #399953;
        background-repeat: no-repeat;
        background-size: 50% 50%, 50% 50%;
        background-position: 0 0, 100% 0, 100% 100%, 0 100%;
        background-image: linear-gradient(#57a279, #57a279),
          linear-gradient(#4f9ebd, #4f9ebd), linear-gradient(#10579c, #10579c),
          linear-gradient(#377af5, #377af5);
        -webkit-animation: rotate 4s linear infinite;
        animation: rotate 4s linear infinite;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      @-webkit-keyframes rotate {
        100% {
          -webkit-transform: rotate(1turn);
          transform: rotate(1turn);
        }
      }

      @keyframes rotate {
        100% {
          -webkit-transform: rotate(1turn);
          transform: rotate(1turn);
        }
      }

      #clock::after {
        content: "";
        position: absolute;
        z-index: -1;
        left: 6px;
        top: 6px;
        width: calc(100% - 12px);
        height: calc(100% - 12px);
        background: #00254a;
        border-radius: 5px;
      }

      .timer {
        text-shadow: 6px 2px 4px grey;
        font-size: 40pt;
        position: absolute;
        left: 50%;
        top: 20%;
        transform: translate(-50%, -50%);
      }

      #nameDiv {
        width: 100vw;
        display: flex;
        justify-content: space-around;
        align-items: center;
        border-radius: 40px;
      }

      .nameDemo {
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 60px;
      }

      #demoWidget {
        width: 100vw;
        display: flex;
        justify-content: space-around;
        align-items: center;
        border-radius: 40px;
      }

      #one {
        text-align: center;
        color: #00254a;
        padding: 5px;
        background-color: #3febf7;
        box-shadow: 10px 10px 20px rgba(0, 0, 0, 0.3),
          -10px -10px 20px rgba(255, 255, 255, 0.3);
      }

      #two {
        text-align: center;
        color: #3febf7;
        padding: 5px;
        background-color: #00254a;
        box-shadow: 10px 10px 20px rgba(0, 0, 0, 0.3),
          -10px -10px 20px rgba(255, 255, 255, 0.3);
      }

      #winner {
        width: 100vw;
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        font-size: 2rem;
        /* transform: translateY(-10px); */
      }

      #winner h1 {
        /* margin-top: 10px; */
      }

      .won-name {
        position: absolute;
        /* top: 21.8%; */
      }

      .congrats {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Gauge Container Styles */
      .gauge-container {
        position: relative;
        width: 400px;
        height: 400px;
        background-image: url("../asset/images/gauge.png");
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .gauge-percentage {
        font-size: 80px;
        font-weight: bold;
        color: #ffcd11;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
        font-family: "ArchivoBlack", sans-serif;
      }

      #gaugeContainer1 {
        /* Additional styles if needed */
      }

      #gaugeContainer2 {
        /* Additional styles if needed */
      }

      #player1 {
        background: white;
        height: 70px;
        width: 420px;
        color: black;
        text-align: center;
        padding-top: 14px;
        font-size: 30px;
        background-color: transparent;

        /* 🖼️ Background image */
        background-image: url("../asset/images/playerbg.png");
        background-size: cover; /* Make image cover the div */
        background-position: center; /* Center the image */
        background-repeat: no-repeat; /* Prevent tiling */
      }
      #player2 {
        background: white;
        height: 70px;
        color: black;
        width: 420px;
        text-align: center;
        padding-top: 14px;
        font-size: 30px;
        background-color: transparent;

        /* 🖼️ Background image */
        background-image: url("../asset/images/playerbg.png");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      }
#name {
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
  font-family: Helvetica, sans-serif;
  font-size: 40px;
  height: 120px; /* adjust based on your image */
  width: 500px;  /* adjust width as needed */
  background-image: url("../asset/images/winnerbg.png");
  background-size: contain; /* Keeps full image visible */
  background-repeat: no-repeat;
  background-position: center;
  border-radius: 20px;
  text-align: center;
  text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.7);
}


      /* Video Container Styles */
      #videoContainer {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: #000;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
      }

      #defaultVideo {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    </style>
  </head>

  <body style="padding: 0; margin: 0; overflow: hidden">
    <!-- Video Container (shown initially) -->
    <div id="videoContainer" >
      <video id="defaultVideo" autoplay loop muted playsinline>
        <source src="../asset/videos/default.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>

    <!-- Game Content (hidden initially) -->
    <div class="nameDemo" style="display: none;">
      <div id="demoWidget"></div>
      <div id="nameDiv"></div>
    </div>

    <div id="winner"style="display: none" >
      <div class="congrats">
        <img src="../asset/images/congrats.png" alt="" width="700px" />
      </div>
      <div class="nameContainerr">
        <h2 id="name" >Yamuna</h2>
      </div>
    </div>

    <script type="text/javascript">
      const socket1 = io();
      const socket2 = io("http://192.168.1.161:3000");

      function createGaugeDisplay(containerId) {
        const container = document.getElementById(containerId);
        container.className = "gauge-container";

        const percentage = document.createElement("div");
        percentage.className = "gauge-percentage";
        percentage.textContent = "0%";
        percentage.id = containerId + "-value";

        container.appendChild(percentage);
      }

      function updateGaugeValue(containerId, value) {
        const percentageElement = document.getElementById(
          containerId + "-value"
        );
        if (percentageElement) {
          percentageElement.textContent = Math.round(value) + "%";
        }
      }

      function createGaugesAndSockets(configurations) {
        const demoWidget = document.getElementById("demoWidget");

        configurations.forEach((config, index) => {
          const gaugeContainer = document.createElement("div");
          const containerId = `gaugeContainer${index + 1}`;
          gaugeContainer.id = containerId;
          demoWidget.appendChild(gaugeContainer);
          createGaugeDisplay(containerId);
        });
      }

      const gaugeConfigurations = [
        {
          containerId: "gaugeContainer1",
          socketUrl: "http://localhost:3000",
          index: 1,
        },
        {
          containerId: "gaugeContainer2",
          socketUrl: "http://192.168.1.161:3000",
          index: 2,
        },
      ];

      createGaugesAndSockets(gaugeConfigurations);

      class H1Element {
        constructor(index) {
          this.element = document.createElement("h1");
          this.element.classList.add("custom-h1");
          this.element = document.createElement("div");
          this.element.id = `player${index}`;
          this.element.textContent = `Player ${index}`;
        }

        appendTo(parentElement) {
          parentElement.appendChild(this.element);
        }
      }

      const container = document.getElementById("nameDiv");
      gaugeConfigurations.forEach((e) => {
        const h1Element = new H1Element(e.index);
        h1Element.appendTo(container);
      });

      var Timer = 5;
      var goBack = () => {
        startTimerInterval = setInterval(() => {
          Timer--;
          if (Timer == 0) {
            clearInterval(startTimerInterval);
            window.location.href = "/";
          }
        }, 1000);
      };

      var stopHere = () => clearInterval(startTimerInterval);

      const nameDiv = document.getElementById("nameDiv");
      const clock = document.getElementById("clock");
      const demoWidget = document.getElementById("demoWidget");
      const winnerDiv = document.getElementById("winner");
      const winnerName = document.getElementById("name");
      const playerOne = document.getElementById("player1");
      const playerTwo = document.getElementById("player2");
      const videoContainer = document.getElementById("videoContainer");
      const nameDemo = document.querySelector(".nameDemo");

      let hasWinnerBeenCalled = false;

      function handleWinner(playerNumber) {
        if (!hasWinnerBeenCalled) {
          hasWinnerBeenCalled = true;
          stopHere();
          let playerName;
          if (playerNumber === 1) {
            playerName = playerOne.innerText;
            socket1.emit("winnerName", playerName);
            socket2.emit("stop");
          } else if (playerNumber === 2) {
            playerName = playerTwo.innerText;
            socket1.emit("winnerName", playerName);
            socket2.emit("stop");
            socket1.emit("stop");
            console.log(playerName, "player 2 is winner");
          }

          let message = `${playerName} `;
          winnerFunction(message);
          console.log(message);
        }
      }

      socket1.on("winnerOne", () => {
        handleWinner(1);
      });

      socket2.on("winnerTwo", () => {
        console.log("winner two reciveddddddddddddddddd ");
        console.log("got from another client");
        handleWinner(2);
      });

      function winnerFunction(value) {
        document.getElementById("gaugeContainer2").style.display = "none";
        document.getElementById("gaugeContainer1").style.display = "none";
        nameDiv.style.display = "none";
        demoWidget.style.display = "none";
        nameDemo.style.display = "none";
        winnerDiv.style.display = "flex";
        winnerName.innerHTML = value;
        goBack();
      }

      socket1.on("getUser", (e) => {
        // Hide video and show game screen
        videoContainer.style.display = "none";
        nameDemo.style.display = "flex";

        playerOne.innerText = e.playerone;
        playerTwo.innerText = e.playertwo;

        socket1.on("meditation", (e) => {
          if (e) {
            updateGaugeValue("gaugeContainer1", e);
          }
        });

        socket2.on("meditation", (e) => {
          if (e) {
            updateGaugeValue("gaugeContainer2", e);
          }
        });

        startHere();
      });

      var MainTimer = 45;
      var startTimerInterval;
      var timer = document.getElementById("timer");
      var startHere = () => {
        startTimerInterval = setInterval(() => {
          MainTimer--;
          timer.innerHTML = MainTimer;
          if (MainTimer == 0) {
            clearInterval(startTimerInterval);
            goBack();
          }
        }, 1000);
      };
    </script>
  </body>
</html>