  <body style="padding: 0; margin: 0; overflow: hidden">
    <!-- <div id="clock" style="z-index: 999">
    <h1 id="timer">45</h1>
  </div> -->
    <div class="maindiv">
      <div class="nameDemo">
        <div id="demoWidget"></div>
