<body style="padding: 0; margin: 0; overflow: hidden">
  <!-- <div id="clock" style="z-index: 999">
    <h1 id="timer">45</h1>
  </div> -->

  <div id="nameDiv"   >
    
  </div>

  <div id="demoWidget"  
    style="position: absolute; display: flex; justify-content: center; align-items: center; top: 15%; left: 24%; padding: 30px; margin: 20px;">
    <!-- Content inside the div goes here -->
  </div>



  </div>
  <div id="winner" style="display: none;"  >
    <div class="nameContainerr">
      <h2 id="name" style="padding-top: 10px;">Yamuna</h2>
    </div>
    
    <div class="congrats">
      <img src="../asset/images/congratulations.png" alt="" width="1200px">
