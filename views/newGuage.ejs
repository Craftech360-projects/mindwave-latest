    <script type="text/javascript">
      const socket1 = io();
      const socket2 = io("http://192.168.1.78:3000");
      // Initialize the gauge
      function initializeGaugeAndSocket(containerId) {
        $(document).ready(function () {
          $(containerId).jqxGauge({
            ranges: [
              {
                startValue: 0,
                endValue: 25,
                style: { fill: "#42ecf8", stroke: "#42ecf8" },
                endWidth: 5,
                startWidth: 1,
              },
              {
                startValue: 25,
                endValue: 50,
                style: { fill: "#42ecf8", stroke: "#42ecf8" },
                endWidth: 10,
                startWidth: 5,
              },
              {
                startValue: 50,
                endValue: 90,
                style: { fill: "#3de0f7", stroke: "#3de0f7" },
                endWidth: 13,
                startWidth: 10,
              },
              {
                startValue: 90,
                style: { fill: "#34c5f8 ", stroke: "#34c5f8 " },
                endWidth: 16,
                startWidth: 13,
              },
            ],
            ticksMinor: { interval: 5, size: "5%" },
            ticksMajor: { interval: 10, size: "9%" },
            value: 0,
            colorScheme: "scheme08",
            animationDuration: 1200,
          });
        });
      }

      function createGaugesAndSockets(configurations) {
        const demoWidget = document.getElementById("demoWidget");

        configurations.forEach((config, index) => {
          // Create a gauge container
          const gaugeContainer = document.createElement("div");

          const containerId = `gaugeContainer${index + 1}`; // Generate a unique ID
          gaugeContainer.id = containerId;

          // Append the gauge container to the demoWidget
          demoWidget.appendChild(gaugeContainer);

          // Initialize the gauge and socket for this container
          initializeGaugeAndSocket(`#${containerId}`);
        });
      }

      // Define an array of gauge configurations
      const gaugeConfigurations = [
        {
          containerId: "#gaugeContainer1",
          socketUrl: "http://localhost:3000",
          index: 1,
        },
        {
          containerId: "#gaugeContainer2",
          socketUrl: "http://192.168.1.78:3000",
          index: 2,
        },
        // Add more configurations as needed
      ];

      // Call the function to create gauges and sockets based on the configurations
      createGaugesAndSockets(gaugeConfigurations);

      // Now, you can access your sockets by their names like this:

      // ... and so on
      class H1Element {
        constructor(index) {
          this.element = document.createElement("h1");
          this.element.classList.add("custom-h1"); // Add a single class name to the h1 element
          this.element = document.createElement("div");
          this.element.id = `player${index}`;
          this.element.textContent = `Player ${index}`;
          // this.element.appendChild(divElement);
        }

        // // Function to append the h1 element to a parent container
        appendTo(parentElement) {
          parentElement.appendChild(this.element);
        }
      }

      // Usage example
      const container = document.getElementById("nameDiv");
      gaugeConfigurations.forEach((e) => {
        // Create an instance of the H1Element class for each gauge configuration
        const h1Element = new H1Element(e.index);

        // Append the h1 element to the container
        h1Element.appendTo(container);
      });

      var Timer = 5;
      var goBack = () => {
        startTimerInterval = setInterval(() => {
          Timer--;
          if (Timer == 0) {
            clearInterval(startTimerInterval);
            window.location.href = "/";
          }
        }, 1000);
      };

      var stopHere = () => clearInterval(startTimerInterval);

      // const socket =io();
      // const socketTwo =io();
      const nameDiv = document.getElementById("nameDiv2");
      const clock = document.getElementById("clock");
      const demoWidget = document.getElementById("demoWidget");
      const winnerDiv = document.getElementById("winner");
      const winnerName = document.getElementById("name");
      const playerOne = document.getElementById("player1");
      const playerTwo = document.getElementById("player2");

      let hasWinnerBeenCalled = false;

      function handleWinner(playerNumber) {
        if (!hasWinnerBeenCalled) {
          hasWinnerBeenCalled = true;
          // stopHere();
          startHere();
          let playerName;
          if (playerNumber === 1) {
            console.log(playerNumber);
            playerName = playerOne.innerText;
            socket1.emit("winnerName", playerName);
            socket2.emit("stop");
          } else if (playerNumber === 2) {
            console.log(playerNumber);
            playerName = playerTwo.innerText;
            socket1.emit("winnerName", playerName);
            socket2.emit("stop");
          }

          let message = `${playerName} `;
          winnerFunction(message);
          console.log(message);
        }
      }

      socket1.on("winnerOne", () => {
        handleWinner(1);
      });

      socket2.on("winnerTwo", () => {
        handleWinner(2);
      });
      // winnerFunction('value')
      //Displaying winner namve and saving to DB
      function winnerFunction(value) {
        document.getElementById("gaugeContainer2").style.display = "none";
        document.getElementById("gaugeContainer1").style.display = "none";
        document.querySelector(".maindiv").style.display = "none";
        // document.querySelector(".nameDiv2").style.display="none"
        // nameDiv.style.display = "none";
        // clock.style.display = "none";

        demoWidget.style.display = "none";

        winnerDiv.style.display = "flex";
        winnerName.innerHTML = value;
        // goBack();
      }

      socket1.on("getUser", (e) => {
        console.log(e);
        playerOne.innerText = e.playerone;
        playerTwo.innerText = e.playertwo;

        socket1.on("meditation", (e) => {
          if (e) {
            $("#gaugeContainer1").jqxGauge("value", e);
          }
        });

        socket2.on("meditation", (e) => {
          if (e) {
            $("#gaugeContainer2").jqxGauge("value", e);
          }
        });
      });

      var MainTimer = 5;
      var startTimerInterval;
      var timer = document.getElementById("timer");
      var startHere = () => {
        startTimerInterval = setInterval(() => {
          MainTimer--;
          if (MainTimer == 0) {
            clearInterval(startTimerInterval);
            // goBack();
            window.location.reload();
          }
        }, 1000);
      };
    </script>
