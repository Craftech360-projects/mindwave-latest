<!DOCTYPE html>
<html>
  <head>
    <script src="/socket.io/socket.io.js"></script>
  </head>
  <style>
    /* @font-face {
      font-family: "ArchivoBlack";
      src: url("../asset/Archivo_Black/ArchivoBlack-Regular.ttf")
        format("truetype");
    } */

    body {
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100vh;
      background-image: url("../asset/images/tab.png");
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
      font-family:sans-serif;
    }

    .p1 {
      border-radius: 45%;
      background-color: #ffffff;
      width: 30%;
    }

    form {
      display: flex;
      flex-direction: column;
    }

    section{
      width: 100vw;
      display: flex;
      flex-direction: row;
      justify-content: space-evenly;
      align-items: center;
    }

    label {
      font-weight: bold;
    }

    input {
      padding: 20px;
      /* padding-left: 40px; */
      background-color: transparent;
      text-align: left;
      border: 3px solid #ffffff;
      margin-bottom: 20px;
      border-radius: 50px;
      font-size: 1rem;
      font-weight: bold;
      text-transform: uppercase;
      color: white;
      border-color: #ffffff;
      width: 400px;
      box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
    }

    input::placeholder {
      color: white;
    }
    #start {
      height: 35px;
      background-color: red;
      margin-left: -60px;
    }

    #ONE,
    #TWO {
      /* position: absolute; */
      background-color: grey;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      float: right;
    }

    .logo {
      position: absolute;
      top: 3%;
      left: 20px;
    }
    .start {
      position: absolute;
    }

    .container {
      position: relative;
    }

    .input-container input:focus {
      border: 2px solid white;
      outline: none;
    }

    .input-container {
      z-index: 999;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      margin-bottom: 30px;
    }

    .box {
      width: 200px;
      height: 80px;
      border-radius: 37px;
      background-color: white;
      text-align: center;
      position: absolute;
      top: 2px;
      left: 60px;
      z-index: -1;
      margin-bottom: 200px;
    }

    .img-p1 {
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .img-start {
      display: flex;
      justify-content: center;
      align-items: center;
      /* margin-top: 60px; */
    }
  </style>

  <body>
    <form id="form">
      <section>
        
      <div>

        <div class="img-p1">
          <img src="../asset/images/player1.png" alt="" width="200px" style="box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;border-top-left-radius: 48px;border-top-right-radius: 48px;" />
        </div>
  
        <div class="input-container">
          <input
            type="text"
            id="playerone"
            name="playerone"
            required
            placeholder="Enter Name"
          />
          <input
            type="number"
            id="playeroneage"
            name="playeroneage"
            required
            placeholder="Enter Age"
          />
          <div id="ONE"></div>
        </div>

      </div>

     <div>
      <div class="img-p1">
        <img src="../asset/images/player2.png" alt="" width="200px" style="box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;border-top-left-radius: 48px;border-top-right-radius: 48px;"/>
      </div>

      <div class="input-container">
        <input
          type="text"
          id="playertwo"
          name="playertwo"
          required
          placeholder="Enter Name"
        />
        <input
          type="number"
          id="playertwoage"
          name="playertwoage"
          required
          placeholder="Enter Age"
        />
        <div id="TWO"></div>
      </div>

      </section>
     </div>
      <div class="img-start">
        <img
          src="./asset/images/start.png"
          onclick="saveName()"
          alt=""
          style="width: 200px; vertical-align: middle;  box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;border-radius: 33px;"
        />
      </div>

    </form>

    <div id="game-started" style="display: none;">
      <h1>Game started.......</h1>
    </div>
    <div id="winnerContainer" style="display: none;">
      <h1 id="winnerName"></h1>
    </div>
    <script>
      const socketOne = io();
      const socketTwo = io();

      const playerOneName = document.getElementById("playerone");
      const playerTwoName = document.getElementById("playertwo");
      const playerOneAge = document.getElementById("playeroneage");
      const playerTwoAge = document.getElementById("playertwoage");
      const isOneActive = document.getElementById("ONE");
      const isTwoActive = document.getElementById("TWO");
      const form = document.getElementById("form");
      const gameStarted = document.getElementById("game-started");
      const winnerContainer = document.getElementById("winnerContainer");
      const winnerName = document.getElementById("winnerName");

      socketOne.on("meditation", (e) => {
        if (e > 0) {
          isOneActive.style.backgroundColor = "green";
        } else {
          isOneActive.style.backgroundColor = "grey";
        }
      });

      socketTwo.on("meditation", (e) => {
        if (e > 0) {
          isTwoActive.style.backgroundColor = "green";
        } else {
          isTwoActive.style.backgroundColor = "grey";
        }
      });

      function saveName() {
        const data = {
          playerOneName: playerOneName.value,
          playerTwoName: playerTwoName.value,
          playerOneAge:playerOneAge.value,
          playerTwoAge:playerTwoAge.value,

        };
        console.log(data);
        // socketTwo.emit("start");
        socketOne.emit("start", data);
        form.style.display = "none";
        gameStarted.style.display = "flex";
      }

      var Timer = 10;
      var goBack = () => {
        startTimerInterval = setInterval(() => {
          Timer--;
          if (Timer == 0) {
            window.location.reload();
          }
        }, 1000);
      };

      let hasWinnerBeenCalled = false;

      function handleWinner(playerNumber) {
        gameStarted.style.display = 'none';
        
        if (!hasWinnerBeenCalled) {
          hasWinnerBeenCalled = true;
          goBack();
          let playerName;
          if (playerNumber === 1) {
            playerName = playerOneName.value;
            // socketTwo.emit("stop");
          } else if (playerNumber === 2) {
            playerName = playerTwoName.value;
            // socketTwo.emit("stop");
            console.log(playerName);
          }
          winnerContainer.style.display = 'flex';
          winnerName.innerText = playerName;
          console.log(playerName);
        }
      }

      socketOne.on("winnerOne", () => {
        handleWinner(1);
      });

      // socketTwo.on("winnerTwo", () => {
      //   handleWinner(2);
      // });
    </script>
  </body>
</html>
