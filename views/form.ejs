<!DOCTYPE html>
<html>

<head>
  <script src="/socket.io/socket.io.js"></script>
</head>
<style>
  @font-face {
    font-family: "ArchivoBlack";
    src: url("../asset/Archivo_Black/ArchivoBlack-Regular.ttf") format("truetype");
    /* Adjust the path and font format accordingly */
  }

  body {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 0;
    width: 100vw;
    height: 100vh;
    background-image: url("../asset/images/tab.png");
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    font-family: "ArchivoBlack", sans-serif;
  }

  .p1 {
    border-radius: 45%;
    background-color: #ffffff;
    width: 30%;
  }

  form {
    display: flex;
    flex-direction: column;
    margin-right: 130px;
    margin-top: 146px;
  }

  label {
    font-weight: bold;
  }

  input {
    padding: 25px;
    padding-left: 40px;
    background-color: white;
    text-align: left;
    border: 3px solid #ffffff;
    margin-bottom: 20px;
    font-size: 1.5rem;
    font-weight: bold;
    text-transform: uppercase;
    color: black;
    width: 500px;
  }

  input::placeholder {
    color: black;
  }

  #start {
    height: 35px;
    background-color: red;
    margin-left: -60px;
  }

  #ONE,
  #TWO {
    position: absolute;
    bottom: 55px;
    /* Moves dot above input */
    right: -50px;
    /* Adjust horizontally */
    background-color: grey;
    width: 20px;
    height: 20px;
    /* border-radius: ; */
  }

  .logo {
    position: absolute;
    top: 3%;
    left: 20px;
  }

  .start {
    position: absolute;
  }

  .container {
    position: relative;
  }

  .input-container input:focus {
    border: 2px solid white;
    outline: none;
    background-color: white;
  }

  .input-container {
    z-index: 999;
    justify-content: left;
  }

  .box {
    width: 200px;
    height: 80px;
    background-color: white;
    text-align: center;
    position: absolute;
    top: 2px;
    left: 60px;
    z-index: -1;
    margin-bottom: 200px;

  }

  .img-start {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 60px;
    background-color: #FFCD11;
    color: black;

    /* Adjust size here */
    height: 50px;
    /* Increased height */
    width: 180px;
    /* Decreased width */
    margin-left: 10px;
  }

  .dot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 20px;
  }
</style>

<body>
  <div class="form-container">
    <form method="post">

      <div class="container">

        <div class="dot">
          <div id="ONE" class="status-dot"></div>
          <div class="input-container">
            <input type="text" id="playerone" name="playerone" required placeholder="Enter Player 01 Name" />
          </div>

        </div>
      </div>
      <div class="container">

        <div class="dot">
          <div id="TWO" class="status-dot"></div>
          <div class="input-container">
            <input type="text" id="playertwo" name="playertwo" required placeholder="Enter Player 02 Name" />
          </div>
        </div>
      </div>
      <div class="img-start">
        <img src="./asset/images/start.png" onclick="saveName()" alt="" style="width: 200px; vertical-align: middle" />
      </div>
    </form>
  </div>
  <script>
    const socket = io();
    const socketTwo = io("http://192.168.1.161:3000");

    const playerOne = document.getElementById("playerone");
    const playerTwo = document.getElementById("playertwo");
    const isOneActive = document.getElementById("ONE");
    const isTwoActive = document.getElementById("TWO");

    socket.on("meditation", (e) => {
      if (e > 0) {
        isOneActive.style.backgroundColor = "green";
      } else {
        isOneActive.style.backgroundColor = "grey";
      }
    });

    socketTwo.on("meditation", (e) => {
      if (e > 0) {
        isTwoActive.style.backgroundColor = "green";
      } else {
        isTwoActive.style.backgroundColor = "grey";
      }
    });

    function saveName() {
      const data = {
        playerone: playerOne.value,
        playertwo: playerTwo.value,
      };
      socketTwo.emit("start");
      socket.emit("start", data);
      playerOne.value = "";
      playerTwo.value = "";
    }
  </script>
</body>

</html>