<!DOCTYPE html>
<html>
  <head>
    <script src="/socket.io/socket.io.js"></script>
  </head>
  <style>
    @font-face {
      font-family: "ArchivoBlack";
      src: url("../asset/Archivo_Black/ArchivoBlack-Regular.ttf")
        format("truetype");
      /* Adjust the path and font format accordingly */
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100vh;
      background-image: url("../asset/images/tab.png");
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
      font-family: "ArchivoBlack", sans-serif;
    }

    .p1 {
      border-radius: 45%;
      background-color: #ffffff;
      width: 30%;
    }

    form {
      display: flex;
      flex-direction: column;
    }

    label {
      font-weight: bold;
    }

    input {
      padding: 25px;
      padding-left: 40px;
      background-color: transparent;
      text-align: left;
      border: 3px solid #ffffff;
      margin-bottom: 20px;
      border-radius: 50px;
      font-size: 1.5rem;
      font-weight: bold;
      text-transform: uppercase;
      color: white;
      border-color: #ffffff;
      width: 500px;
    }

    input::placeholder {
      color: white;
    }
    #start {
      height: 35px;
      background-color: red;
      margin-left: -60px;
    }

    #ONE,
    #TWO {
      position: absolute;
      background-color: grey;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      float: right;
    }

    .logo {
      position: absolute;
      top: 3%;
      left: 20px;
    }
    .start {
      position: absolute;
    }

    .container {
      position: relative;
    }

    .input-container input:focus {
      border: 2px solid white;
      outline: none;
    }

    .input-container {
      z-index: 999;
      justify-content: left;
    }

    .box {
      width: 200px;
      height: 80px;
      border-radius: 37px;
      background-color: white;
      text-align: center;
      position: absolute;
      top: 2px;
      left: 60px;
      z-index: -1;
      margin-bottom: 200px;
    }

    .img-p1 {
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .img-start {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 60px;
    }
    .dot {
      display: flex;
      justify-content: center;
      align-items: center;
    }
  </style>

  <body>
    <div class="form-container">
      <form method="post">
        <div>
          <!-- <div class="logo">
    <img src="../asset/images/logo.png" alt="" width="100px">
  </div> -->
          <div class="container">
            <div class="img-p1">
              <img src="../asset/images/player1.png" alt="" width="200px" />
            </div>
            <div class="dot">
              <div class="input-container">
                <input
                  type="text"
                  id="playerone"
                  name="playerone"
                  required
                  placeholder="Enter Name"
                />
              </div>
              <div id="start">
                <div id="ONE"></div>
              </div>
            </div>
          </div>
          <div class="container">
            <div class="img-p1">
              <img src="../asset/images/player2.png" alt="" width="200px" />
            </div>
            <div class="dot">
              <div class="input-container">
                <input
                  type="text"
                  id="playertwo"
                  name="playertwo"
                  required
                  placeholder="Enter Name"
                />
              </div>
              <div id="start">
                <div id="TWO"></div>
              </div>
            </div>
          </div>
          <div class="img-start">
            <img
              src="./asset/images/start.png"
              onclick="saveName()"
              alt=""
              style="width: 200px; vertical-align: middle"
            />
          </div>
        </div>
      </form>
    </div>
    <script>
      const socket = io();
      const socketTwo = io("http://192.168.0.233:3000");

      const playerOne = document.getElementById("playerone");
      const playerTwo = document.getElementById("playertwo");
      const isOneActive = document.getElementById("ONE");
      const isTwoActive = document.getElementById("TWO");

      socket.on("meditation", (e) => {
        if (e > 0) {
          isOneActive.style.backgroundColor = "green";
        } else {
          isOneActive.style.backgroundColor = "grey";
        }
      });

      socketTwo.on("meditation", (e) => {
        if (e > 0) {
          isTwoActive.style.backgroundColor = "green";
        } else {
          isTwoActive.style.backgroundColor = "grey";
        }
      });

      function saveName() {
        const data = {
          playerone: playerOne.value,
          playertwo: playerTwo.value,
        };
        // The master server writes 's' to its ESP32 and relays "start" to the
        // client laptop's server itself (see relayToPeer in app.js).
        socket.emit("start", data);
        playerOne.value = "";
        playerTwo.value = "";
      }
    </script>
  </body>
</html>
